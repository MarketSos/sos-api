{
  "IdentityService": {
    "Authority": "http://localhost:5001"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/identity/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/{**catch-all}" }]
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/catalog/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/{**catch-all}" }]
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": { "Path": "/api/inventory/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/{**catch-all}" }]
      },
      "pos-route": {
        "ClusterId": "pos-cluster",
        "Match": { "Path": "/api/pos/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/{**catch-all}" }]
      },
      "pricing-route": {
        "ClusterId": "pricing-cluster",
        "Match": { "Path": "/api/pricing/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/{**catch-all}" }]
      },
      "crm-route": {
        "ClusterId": "crm-cluster",
        "Match": { "Path": "/api/crm/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/{**catch-all}" }]
      },
      "loyalty-route": {
        "ClusterId": "loyalty-cluster",
        "Match": { "Path": "/api/loyalty/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/{**catch-all}" }]
      },
      "analytics-route": {
        "ClusterId": "analytics-cluster",
        "Match": { "Path": "/api/analytics/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/{**catch-all}" }]
      }
    },
    "Clusters": {
      "identity-cluster":  { "Destinations": { "d1": { "Address": "http://localhost:5001" } } },
      "catalog-cluster":   { "Destinations": { "d1": { "Address": "http://localhost:5002" } } },
      "inventory-cluster": { "Destinations": { "d1": { "Address": "http://localhost:5003" } } },
      "pos-cluster":       { "Destinations": { "d1": { "Address": "http://localhost:5004" } } },
      "pricing-cluster":   { "Destinations": { "d1": { "Address": "http://localhost:5005" } } },
      "crm-cluster":       { "Destinations": { "d1": { "Address": "http://localhost:5006" } } },
      "loyalty-cluster":   { "Destinations": { "d1": { "Address": "http://localhost:5007" } } },
      "analytics-cluster": { "Destinations": { "d1": { "Address": "http://localhost:5008" } } }
    }
  },
  "Serilog": {
    "MinimumLevel": "Information"
  }
}
